# LOCAL: copy to .streamlit/secrets.toml
# CLOUD: paste the same content in Streamlit App Settings -> Secrets
# NEVER commit your real secrets.toml to GitHub.

[deployment]
mode = "production"

[app]
timezone = "America/Chicago"

[auth]
enabled = true

[users.admin]
display_name = "Church Administrator"
role = "admin"
password_hash = "REPLACE_WITH_BCRYPT_HASH"

[users.parking]
display_name = "Parking Volunteer"
role = "volunteer"
password_hash = "REPLACE_WITH_BCRYPT_HASH"

# Supabase Project URL and the NEW server-side Secret Key.
# Use an sb_secret_... key, not a publishable key.
# Keep this key only in Streamlit Secrets.
[supabase]
url = "https://YOUR_PROJECT_REF.supabase.co"
secret_key = "sb_secret_REPLACE_ME"
bucket = "violation-photos"
